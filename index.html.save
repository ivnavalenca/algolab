<!-- ==========================================================
     DASHBOARD ALGOLAB - FINAL
========================================================== -->
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Algolab Dashboard</title>

    <!-- CSS EXTERNO -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- ====================================================== -->
<!-- HEADER -->
<!-- ====================================================== -->
<header class="topbar">
    <h1>Algolab</h1>
    <p>Análise de Algoritmos</p>
</header>

<main class="container">

    <!-- ====================================================== -->
    <!-- STATUS / BADGES -->
    <!-- ====================================================== -->
    <section>
        <h2>Status do Projeto</h2>

        <div class="badges">
            <img src="assets/badge_summary.svg" alt="Resumo">
            <img src="assets/badge_best.svg" alt="Melhor algoritmo">
            <img src="assets/badge_quality.svg" alt="Qualidade">
            <img src="assets/badge_trend.svg" alt="Tendência">
            <img src="assets/badge_project_score.svg" alt="Score do projeto">
        </div>
    </section>

    <!-- ====================================================== -->
    <!-- COMPARAÇÃO PRINCIPAL -->
    <!-- ====================================================== -->
    <section>
        <h2>Comparação de Algoritmos</h2>

        <div class="grid">

            <div class="card">
                <img src="resultados/graficos/line_chart.png" alt="Comparação geral">
                <p>Comparação geral de desempenho</p>
            </div>

            <div class="card">
                <img src="resultados/graficos/comparison_chart.png" alt="Comparação detanano docs/index.html

        <div class="grid">

            <div class="card">
                <img src="resultados/graficos/boxplot_geral.png" alt="Boxplot">
                <p>Distribuição estatística (boxplot)</p>
            </div>

            <div class="card">
                <img src="assets/history_chart.png" alt="Histórico">
                <p>Evolução histórica dos resultados</p>
            </div>v>
    </section>

</main>

<!-- ====================================================== -->
<!-- FOOTER -->
<!-- ====================================================== -->
<footer>
    
